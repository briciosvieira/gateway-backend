NODE_ENV=development
APP_NAME=Gateway Hub LF
HOST=0.0.0.0
PORT=3110

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gateway_hub?schema=public"
DATABASE_POOL_MAX="20"

INITIAL_ADMIN_NAME="Administrador Gateway"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@gatewayhub.local"
INITIAL_ADMIN_PASSWORD="CHANGE_ME"

JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"

JWT_ACCESS_EXPIRES_IN="300m"
JWT_REFRESH_EXPIRES_IN="7d"

API_KEY_PEPPER="CHANGE_ME"

HEADER_ENCRYPTION_KEY="CHANGE_ME"

REQUEST_LOG_BODY_MAX_BYTES="16384"
REQUEST_LOG_RETENTION_DAYS="90"

ALLOWED_ORIGINS="http://localhost:5173"
BODY_LIMIT="5242880"

HTTPS_ENABLED="false"
EXPOSE_VERSION_HEADER="true"

DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/gateway_hub_test?schema=public"
